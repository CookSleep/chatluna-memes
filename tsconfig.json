{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib",
    "target": "es2022",
    "jsx": "react-jsx",
    "paths": { "react": ["./node_modules/@types/react/index.d.ts"], "react/*": ["./node_modules/@types/react/*"] },
    "module": "esnext",
    "declaration": true,
    "composite": true,
    "incremental": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "emitDeclarationOnly": true,
    "moduleResolution": "bundler",
    "types": ["node"]
  },
  "include": ["src"]
}
