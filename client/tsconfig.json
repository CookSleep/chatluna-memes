{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@koishijs/client": [
        "./koishi-client.d.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "../src/console-rpc.ts",
    "../src/constants.ts"
  ]
}
