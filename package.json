{
  "name": "chatluna-plugin-memes",
  "description": "为 ChatLuna 提供表情包：管理本地表情包和外部随机图源，注入随机图清单让模型发表情，支持 AI 标注与群聊高频图片收集",
  "version": "0.1.0",
  "homepage": "https://github.com/CookSleep/chatluna-memes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CookSleep/chatluna-memes.git"
  },
  "bugs": {
    "url": "https://github.com/CookSleep/chatluna-memes/issues"
  },
  "keywords": [
    "chatluna-plugin",
    "chatluna",
    "meme",
    "sticker",
    "emoji"
  ],
  "contributors": [
    "CookSleep",
    "lumia1998"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "dist",
    "client/dev.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json --noCheck --emitDeclarationOnly && esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --packages=external --outfile=lib/index.js && vite build --config client/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.3.6",
    "formidable": "^3.5.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/formidable": "^3.4.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/shared": "^3.5.35",
    "element-plus": "^2.11.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.3",
    "vite": "5.4.21",
    "vitest": "^1.6.1",
    "vue": "^3.5.0"
  },
  "peerDependencies": {
    "@chatluna/ai-runtime": "*",
    "@chatluna/search": "*",
    "@chatluna/utils": "*",
    "@cordisjs/plugin-database": "*",
    "@satorijs/core": "*",
    "cordis": "^4.0.0-rc.12",
    "schemastery": "*"
  },
  "peerDependenciesMeta": {
    "cordis": {
      "optional": true
    },
    "schemastery": {
      "optional": true
    },
    "@chatluna/utils": {
      "optional": true
    },
    "@chatluna/search": {
      "optional": true
    },
    "@chatluna/ai-runtime": {
      "optional": true
    },
    "@cordisjs/plugin-database": {
      "optional": true
    },
    "@satorijs/core": {
      "optional": true
    }
  },
  "type": "module",
  "cordis": {
    "category": "tool",
    "description": {
      "zh": "为 ChatLuna 提供表情包：管理本地表情包和外部随机图源，注入随机图清单让模型发表情，支持 AI 标注与群聊高频图片收集"
    },
    "service": {
      "implements": [
        "chatluna_memes"
      ],
      "required": [
        "database"
      ],
      "optional": [
        "http",
        "koishi",
        "timer",
        "prompt",
        "ai",
        "server",
        "chatluna_webui",
        "chatluna_server"
      ]
    }
  }
}
