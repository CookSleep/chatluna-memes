{
  "name": "koishi-plugin-chatluna-memes",
  "description": "为 ChatLuna 提供表情包：管理本地表情包和外部随机图源，注入随机图清单让模型发表情，支持 AI 标注与群聊高频图片收集",
  "version": "0.1.1",
  "homepage": "https://github.com/CookSleep/chatluna-memes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CookSleep/chatluna-memes.git"
  },
  "bugs": {
    "url": "https://github.com/CookSleep/chatluna-memes/issues"
  },
  "keywords": [
    "koishi",
    "chatluna",
    "meme",
    "sticker",
    "emoji"
  ],
  "contributors": [
    "CookSleep",
    "lumia1998"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "dist"
  ],
  "scripts": {
    "build": "yakumo build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.3.6",
    "@langchain/core": "^0.3.80",
    "formidable": "^3.5.4",
    "koishi-plugin-chatluna": "^1.3.0-alpha.49"
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.11",
    "@koishijs/plugin-console": "^5.30.11",
    "@koishijs/plugin-server": "^3.2.7",
    "@vitest/coverage-v8": "^1.6.1",
    "koishi": "^4.18.9",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1",
    "yakumo": "^1.0.0",
    "yakumo-esbuild": "^1.0.0",
    "yakumo-tsc": "^1.0.0"
  },
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.30.11",
    "@koishijs/plugin-server": "^3.2.7",
    "koishi": "^4.18.9",
    "koishi-plugin-chatluna": "^1.3.0-alpha.49"
  },
  "peerDependenciesMeta": {
    "@koishijs/plugin-console": {
      "optional": true
    },
    "@koishijs/plugin-server": {
      "optional": true
    }
  },
  "koishi": {
    "category": "ai",
    "description": {
      "zh": "为 ChatLuna 提供表情包：管理本地表情包和外部随机图源，注入随机图清单让模型发表情，支持 AI 标注与群聊高频图片收集"
    },
    "service": {
      "implements": [
        "chatluna_memes"
      ],
      "required": [
        "database"
      ],
      "optional": [
        "server",
        "console",
        "auth",
        "chatluna"
      ]
    },
    "locales": [
      "zh-CN"
    ],
    "icon": "mdi:emoticon-outline"
  }
}
