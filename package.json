{
  "name": "koishi-plugin-memesluna",
  "description": "Image Forward service for Koishi with ChatLuna integration",
  "version": "0.6.0-alpha.14",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumia1998/koishi-plugin-memesluna.git"
  },
  "homepage": "https://github.com/lumia1998/koishi-plugin-memesluna#readme",
  "bugs": {
    "url": "https://github.com/lumia1998/koishi-plugin-memesluna/issues"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "dist"
  ],
  "scripts": {
    "build": "yakumo build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p client/tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "keywords": [
    "koishi",
    "plugin",
    "chatluna",
    "meme",
    "image-forward"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@cf-wasm/photon": "^0.3.6",
    "@langchain/core": "^0.3.80",
    "formidable": "^3.5.4",
    "koishi-plugin-chatluna": "^1.3.0-alpha.49"
  },
  "devDependencies": {
    "@koishijs/client": "^5.30.11",
    "@koishijs/plugin-console": "^5.30.11",
    "@koishijs/plugin-server": "^3.2.7",
    "@vitest/coverage-v8": "^1.6.1",
    "koishi": "^4.18.9",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1",
    "yakumo": "^1.0.0",
    "yakumo-esbuild": "^1.0.0",
    "yakumo-tsc": "^1.0.0"
  },
  "peerDependencies": {
    "@koishijs/plugin-console": "^5.30.11",
    "@koishijs/plugin-server": "^3.2.7",
    "koishi": "^4.18.9",
    "koishi-plugin-chatluna": "^1.3.0-alpha.49"
  },
  "peerDependenciesMeta": {
    "@koishijs/plugin-console": {
      "optional": true
    },
    "@koishijs/plugin-server": {
      "optional": true
    }
  },
  "koishi": {
    "description": {
      "zh": "图片转发服务插件，支持 302 重定向，支持 {memesluna} 变量注入 ChatLuna"
    },
    "service": {
      "implements": [
        "memesluna"
      ],
      "required": [
        "database",
        "chatluna",
        "server"
      ],
      "optional": [
        "console",
        "auth"
      ]
    },
    "locales": [
      "zh-CN"
    ],
    "browser": true,
    "icon": "mdi:emoticon-outline"
  }
}
